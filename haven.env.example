# Haven secrets. Copy this file to "haven.env" (same folder as docker-compose.yml)
# and fill in only the brands you use. config/config.yaml refers to these as ${NAME}.
# No quotes needed. No spaces around "=".

# First admin account (only used when Haven starts with no accounts). You're asked to change the
# password at the first sign-in. Defaults: admin / haven-admin. CHANGE THEM before exposing Haven.
# HAVEN_ADMIN_USER=admin
# HAVEN_ADMIN_PASSWORD=

# --- YoLink ---  YoLink app > Settings > Account > Advanced Settings > User Access Credentials
YOLINK_UAID=
YOLINK_SECRET=

# --- Aqara ---  developer.aqara.com > Console > your project (App ID, App Key, Key ID)
# Tokens are NOT needed here: run `python -m app.aqara_login` in the container once instead.
AQARA_APP_ID=
AQARA_APP_KEY=
AQARA_KEY_ID=

# --- X-Sense ---  use a SECOND X-Sense account that your devices are shared to
XSENSE_USER=
XSENSE_PASS=

# --- MQTT ---  leave blank for the bundled mosquitto broker
MQTT_USER=
MQTT_PASS=

# --- UPS (NUT) ---  only if you set login credentials on the UniFi UPS NUT server
NUT_USER=
NUT_PASS=
